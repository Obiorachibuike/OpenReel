# Copy to .env for Docker Compose. These are local development defaults only.
POSTGRES_PASSWORD=change-this-development-password
DATABASE_URL=postgresql+psycopg://openreel:change-this-development-password@db:5432/openreel
STORAGE_PATH=/data/media
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_LIMIT_MB=100
# Both API and worker need these to enable optional local script generation.
OLLAMA_URL=
OLLAMA_MODEL=
